@model LeaveManagement.Models.CreateEmployeeViewModel
@{ ViewData["Title"] = "Add employee"; }
<section class="page-heading"><div><div class="eyebrow">PEOPLE OPERATIONS <span> / </span> TEAM</div><h1>Add employee</h1><p>Create an employee sign-in for your team.</p></div><a class="btn btn-light" asp-action="Index">← Team</a></section>
<section class="form-panel"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="row g-3"><div class="col-md-6"><label asp-for="DisplayName" class="form-label">Employee name</label><input asp-for="DisplayName" class="form-control" autocomplete="name" placeholder="e.g. Alex Morgan"/><span asp-validation-for="DisplayName" class="field-validation"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label">Work email</label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="alex@company.com"/><span asp-validation-for="Email" class="field-validation"></span></div><div class="col-md-6"><label asp-for="InitialPassword" class="form-label">Initial password</label><input asp-for="InitialPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="InitialPassword" class="field-validation"></span><small class="form-hint">Use at least 8 characters, including a lowercase letter.</small></div><div class="col-md-6"><label asp-for="ConfirmPassword" class="form-label">Confirm password</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="field-validation"></span></div></div><div class="form-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button type="submit" class="btn btn-primary">Create employee</button></div></form></section>
